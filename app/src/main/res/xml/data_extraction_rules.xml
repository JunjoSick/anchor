<?xml version="1.0" encoding="utf-8"?>
<!-- Back up goals, notes, reminders and settings, but never transient timer or snooze state. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="timer.xml" />
        <exclude domain="sharedpref" path="trip.xml" />
        <exclude domain="sharedpref" path="reminder_snoozes.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="timer.xml" />
        <exclude domain="sharedpref" path="trip.xml" />
        <exclude domain="sharedpref" path="reminder_snoozes.xml" />
    </device-transfer>
</data-extraction-rules>
