<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon for these. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="add_goal"
        android:shortcutShortLabel="@string/shortcut_add">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="dev.junjo.anchor.QuickAddActivity"
            android:targetPackage="dev.junjo.anchor" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="new_note"
        android:shortcutShortLabel="@string/shortcut_note">
        <intent
            android:action="dev.junjo.anchor.NEW_NOTE"
            android:targetClass="dev.junjo.anchor.QuickAddActivity"
            android:targetPackage="dev.junjo.anchor" />
    </shortcut>
</shortcuts>
